# Required
LLM_API_KEY=your-openai-key
# At least 12 characters
HR_PASSWORD=change-me-please

# Local dev without Docker (Compose overrides this)
DATABASE_URL=postgresql+psycopg://hr:change-me@localhost:5432/hr_triage

# Optional: defaults shown
# APP_NAME=HR Triage
# EXTRACTION_MODEL=gpt-5.4-nano
# DRAFT_MODEL=gpt-5.4-mini

# Optional: Langfuse tracing (leave out to disable)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com